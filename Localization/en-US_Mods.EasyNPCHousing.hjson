# This file will automatically update with entries for new content after a build and reload.
# Please read https://github.com/tModLoader/tModLoader/wiki/Localization to learn more about localization and these files.

Items: {
	EasyNPCHousingWand: {
		DisplayName: Easy NPC Housing Wand
		Tooltip:
			'''
			Build an NPC house on demand. 
			House is 5 (Length) by 12 (Height)
			Cursor palcement is the bottom left corner of the house
			'''
	}
}

Configs: {
	EasyNPCHousingConfig: {
		DisplayName: Easy NPC Housing Config

		OverwriteMode: {
			Label: Overwrite Mode
			Tooltip: Pick an overwrite mode of blocks you are ok with being able to be overwritten.
		}

		CustomAllowedTiles: {
			Label: Custom Allowed Tiles
			Tooltip: Feel free to make a list of blocks that you think can be overwritten. Needs to be the ID value of the block. (Ex: Placed Tin Ore = 166).
		}
	}

	OverwriteableBlockGroups: {
		Tooltip: Different groups of blocks in the game.

		None: {
			Label: None
			Tooltip: No blocks can be overwritten.
		}

		WoodOnly: {
			Label: Wood Only
			Tooltip: Only wood blocks can be overwritten.
		}

		NaturalBlocks: {
			Label: Natural Blocks
			Tooltip: Only common natural surface blocks can be overwritten.
		}

		Everything: {
			Label: Everything
			Tooltip: Everything can be overwritten.
		}

		Custom: {
			Label: Custom
			Tooltip: If set to this, your custom set of blocks to be overwritten will be used.
		}

		WoodAndNaturalBlocks: {
			Label: Wood And Natural Blocks
			Tooltip: Wood blocks and common surface blocks can be overwritten.
		}
	}
}
